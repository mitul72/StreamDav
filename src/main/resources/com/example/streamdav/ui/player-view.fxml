<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.Slider?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.media.MediaView?>

<StackPane fx:id="root" styleClass="player-view" focusTraversable="true"
           xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.example.streamdav.ui.PlayerController">
    <MediaView fx:id="mediaView" preserveRatio="true"/>
    <VBox fx:id="audioPane" styleClass="audio-pane" visible="false" mouseTransparent="true">
        <Label fx:id="audioTitle" styleClass="audio-title" wrapText="true"/>
    </VBox>
    <ProgressIndicator fx:id="buffering" maxWidth="56" maxHeight="56" visible="false" mouseTransparent="true"/>
    <BorderPane fx:id="overlay" pickOnBounds="false">
        <top>
            <HBox styleClass="player-top">
                <Button fx:id="closeButton" styleClass="icon-button" onAction="#close">
                    <tooltip><Tooltip text="Back (Esc)"/></tooltip>
                </Button>
                <Label fx:id="titleLabel" styleClass="player-title"/>
            </HBox>
        </top>
        <bottom>
            <VBox fx:id="controls" styleClass="player-controls">
                <Slider fx:id="seekSlider" styleClass="seek-slider"/>
                <HBox styleClass="player-buttons">
                    <Button fx:id="playButton" styleClass="icon-button" onAction="#togglePlay">
                        <tooltip><Tooltip text="Play/pause (Space)"/></tooltip>
                    </Button>
                    <Label fx:id="timeLabel" styleClass="time-label" text="0:00 / --:--"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button fx:id="muteButton" styleClass="icon-button" onAction="#toggleMute">
                        <tooltip><Tooltip text="Mute (M)"/></tooltip>
                    </Button>
                    <Slider fx:id="volumeSlider" styleClass="volume-slider" max="1" value="1" prefWidth="110"/>
                    <Button fx:id="externalButton" styleClass="icon-button" onAction="#openExternally">
                        <tooltip><Tooltip text="Open in external player"/></tooltip>
                    </Button>
                    <Button fx:id="fullScreenButton" styleClass="icon-button" onAction="#toggleFullScreen">
                        <tooltip><Tooltip text="Full screen (F)"/></tooltip>
                    </Button>
                </HBox>
            </VBox>
        </bottom>
    </BorderPane>
    <Label fx:id="toastLabel" styleClass="toast" visible="false" mouseTransparent="true" StackPane.alignment="TOP_CENTER">
        <StackPane.margin>
            <Insets top="72"/>
        </StackPane.margin>
    </Label>
    <VBox fx:id="errorPane" styleClass="player-error" visible="false" maxWidth="520" maxHeight="-Infinity">
        <Label fx:id="errorLabel" wrapText="true"/>
        <HBox styleClass="actions">
            <Button text="Open in external player" defaultButton="true" onAction="#openExternally"/>
            <Button text="Back" onAction="#close"/>
        </HBox>
    </VBox>
</StackPane>
