<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane styleClass="connect-view" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.streamdav.ui.ConnectController">
    <top>
        <VBox styleClass="header">
            <Label styleClass="app-title" text="StreamDav"/>
            <Label styleClass="subtitle" text="Stream video and music from your WebDAV server"/>
        </VBox>
    </top>
    <center>
        <HBox styleClass="content">
            <VBox styleClass="card" prefWidth="340" HBox.hgrow="ALWAYS">
                <Label styleClass="card-title" text="Saved servers"/>
                <ListView fx:id="savedServers" styleClass="server-list" VBox.vgrow="ALWAYS"/>
                <HBox alignment="CENTER_RIGHT">
                    <Button fx:id="removeServerButton" text="Remove" onAction="#removeServer"/>
                </HBox>
            </VBox>
            <VBox styleClass="card" prefWidth="460" HBox.hgrow="ALWAYS">
                <Label styleClass="card-title" text="Connect to a server"/>
                <GridPane hgap="12" vgap="10">
                    <columnConstraints>
                        <ColumnConstraints minWidth="80"/>
                        <ColumnConstraints hgrow="ALWAYS"/>
                    </columnConstraints>
                    <Label styleClass="form-label" text="Address" GridPane.rowIndex="0"/>
                    <TextField fx:id="urlField" promptText="https://nas.local/webdav/"
                               GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                    <Label styleClass="form-label" text="Username" GridPane.rowIndex="1"/>
                    <TextField fx:id="usernameField" promptText="Leave empty for anonymous access"
                               GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                    <Label styleClass="form-label" text="Password" GridPane.rowIndex="2"/>
                    <PasswordField fx:id="passwordField" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
                    <Label styleClass="form-label" text="Name" GridPane.rowIndex="3"/>
                    <TextField fx:id="nameField" promptText="Optional, e.g. Living room NAS"
                               GridPane.columnIndex="1" GridPane.rowIndex="3"/>
                </GridPane>
                <CheckBox fx:id="saveServerCheck" text="Save this server" selected="true"/>
                <CheckBox fx:id="rememberPasswordCheck" text="Remember password"/>
                <Label fx:id="passwordHint" styleClass="hint" wrapText="true"
                       text="The password is stored unencrypted in your user preferences."/>
                <HBox styleClass="actions">
                    <Button fx:id="connectButton" styleClass="primary" text="Connect" defaultButton="true"
                            onAction="#connect"/>
                    <ProgressIndicator fx:id="progress" styleClass="small-progress" visible="false"/>
                    <Label fx:id="progressLabel" styleClass="hint"/>
                    <Button fx:id="cancelButton" text="Cancel" visible="false" onAction="#cancel"/>
                </HBox>
                <Label fx:id="statusLabel" styleClass="error-text" wrapText="true"/>
            </VBox>
        </HBox>
    </center>
</BorderPane>
